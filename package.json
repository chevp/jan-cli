{
  "name": "jan-cli",
  "version": "0.1.0",
  "description": "Thin wrapper that exposes chevp/chi as the `jan` command",
  "type": "module",
  "bin": {
    "jan": "bin/jan"
  },
  "files": [
    "bin",
    "chi",
    "scripts",
    "install.sh",
    "install.ps1",
    "README.md"
  ],
  "scripts": {
    "build": "cd chi && npm install --no-audit --no-fund && npm run build",
    "prepare": "node scripts/prepare.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chevp/jan-cli.git"
  },
  "homepage": "https://github.com/chevp/jan-cli#readme",
  "bugs": {
    "url": "https://github.com/chevp/jan-cli/issues"
  },
  "license": "MIT"
}
